# =============================================================================
# AI Service (FastAPI)
# Copy to `ai/.env`
# =============================================================================

# Gemini / Google GenAI
GOOGLE_API_KEY=

# Optional: HuggingFace token (only needed if you hit HF gated models)
HF_TOKEN=

# Optional: protect the AI service with a shared secret
# If empty, auth is disabled.
AI_API_KEY=
AI_API_KEY_HEADER=X-API-Key

# Optional: AWS creds (only needed if the AI service needs to download from private S3 URLs)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
