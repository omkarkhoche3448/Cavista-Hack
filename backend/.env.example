# =============================================================================
# Backend (FastAPI)
# Copy to `backend/.env`
# =============================================================================
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Legacy fallback (if set, backend will still use it)
SUPABASE_KEY=
# Optional (frontend should use its own anon key)
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

# AWS (for documents + recordings)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# AI service base URL (this repo's AI service runs on :8001 in docker-compose)
ANALYSIS_API_URL=http://localhost:8001

# Comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173
